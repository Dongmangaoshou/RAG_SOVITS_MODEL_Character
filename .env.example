# ============================================================
# GPT-SoVITS 虚拟角色对话系统 · 环境变量模板
# 复制为 .env 并填入你的密钥：cp .env.example .env
# 注意：.env 已被 .gitignore 排除，不会提交到仓库
# ============================================================

# --- LLM 大语言模型（必需）-------------------------------------
# DeepSeek API Key（https://platform.deepseek.com/ 获取）
DEEPSEEK_API_KEY=

# 可选：其他 LLM Provider（OpenAI 兼容）
# OPENAI_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash

# --- TTS 语音合成 ---------------------------------------------
# GPT-SoVITS 服务地址（本地 api_v2.py 默认端口 9880）
# TTS_API_URL=http://127.0.0.1:9880

# --- 可选：语音情感第二通道（SenseVoice）-----------------------
# 如需语音情感识别增强，填入 funasr 相关配置
# SENSEVOICE_ENABLED=false

# --- 可选：其他服务 --------------------------------------------
# ELEVENLABS_API_KEY=
# GEMINI_API_KEY=
